<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#ec4899"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Pen tool icon -->
  <g transform="translate(400, 250)" fill="none" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M-80 80 L0 -40 L80 80" />
    <path d="M-40 80 L40 80" />
    <circle cx="0" cy="-40" r="12" fill="white" stroke="none"/>
    <circle cx="-80" cy="80" r="8" fill="white" stroke="none"/>
    <circle cx="80" cy="80" r="8" fill="white" stroke="none"/>
  </g>
  <!-- Figma-style diamonds -->
  <g transform="translate(400, 380)" fill="none" stroke="white" stroke-width="3" opacity="0.4">
    <rect x="-80" y="-15" width="30" height="30" rx="6"/>
    <rect x="-40" y="-15" width="30" height="30" rx="6"/>
    <rect x="0" y="-15" width="30" height="30" rx="6"/>
    <rect x="40" y="-15" width="30" height="30" rx="6"/>
    <rect x="80" y="-15" width="30" height="30" rx="6"/>
  </g>
  <text x="400" y="510" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="36" fill="white" font-weight="bold" letter-spacing="2">FIGMA CLONE</text>
  <text x="400" y="545" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="16" fill="white" opacity="0.6" letter-spacing="3">UI/UX DESIGN TOOL</text>
</svg>