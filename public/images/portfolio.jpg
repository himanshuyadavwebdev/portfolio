<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1"/>
      <stop offset="100%" style="stop-color:#8b5cf6"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Terminal icon -->
  <g transform="translate(400, 220)" fill="none" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="-100" y="-70" width="200" height="140" rx="10"/>
    <!-- Terminal circles -->
    <circle cx="-75" cy="-42" r="6" fill="#ef4444" stroke="none"/>
    <circle cx="-50" cy="-42" r="6" fill="#eab308" stroke="none"/>
    <circle cx="-25" cy="-42" r="6" fill="#22c55e" stroke="none"/>
    <!-- Prompt line -->
    <path d="M-75 -10 L-45 10 L-75 30"/>
    <!-- Code line 2 -->
    <line x1="-40" y1="10" x2="60" y2="10"/>
    <!-- Cursor -->
    <rect x="65" y="4" width="12" height="14" fill="white" opacity="0.7" rx="1"/>
  </g>
  <!-- User icon -->
  <g transform="translate(400, 370)" fill="none" stroke="white" stroke-width="4" opacity="0.5">
    <circle cx="0" cy="-20" r="18"/>
    <path d="M-35 40 Q-35 10 0 10 Q35 10 35 40"/>
  </g>
  <text x="400" y="510" text-anchor="middle" font-family="Inter, monospace" font-size="36" fill="white" font-weight="bold" letter-spacing="2">PORTFOLIO</text>
  <text x="400" y="545" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="16" fill="white" opacity="0.6" letter-spacing="3">DEVELOPER PORTFOLIO</text>
</svg>