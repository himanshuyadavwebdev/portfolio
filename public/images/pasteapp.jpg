<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#64748b"/>
      <stop offset="100%" style="stop-color:#22c55e"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Code brackets -->
  <g transform="translate(400, 240)" fill="none" stroke="white" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M-100 -60 L-130 -20 L-100 20"/>
    <path d="M100 -60 L130 -20 L100 20"/>
    <!-- Slash -->
    <line x1="20" y1="-70" x2="-20" y2="70"/>
  </g>
  <!-- Code lines decoration -->
  <g fill="none" stroke="white" stroke-width="3" stroke-linecap="round" opacity="0.3">
    <line x1="200" y1="380" x2="300" y2="380"/>
    <line x1="220" y1="410" x2="340" y2="410"/>
    <line x1="460" y1="380" x2="600" y2="380"/>
    <line x1="480" y1="410" x2="560" y2="410"/>
  </g>
  <!-- Clipboard note icon -->
  <g transform="translate(400, 380)" fill="none" stroke="white" stroke-width="3" opacity="0.4">
    <rect x="-80" y="-30" width="160" height="60" rx="6"/>
    <circle cx="-50" cy="0" r="6" fill="white"/>
    <line x1="-30" y1="0" x2="50" y2="0"/>
  </g>
  <text x="400" y="510" text-anchor="middle" font-family="Inter, monospace" font-size="36" fill="white" font-weight="bold" letter-spacing="2">PASTEAPP</text>
  <text x="400" y="545" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="16" fill="white" opacity="0.6" letter-spacing="3">CODE &amp; NOTES</text>
</svg>