<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6"/>
      <stop offset="100%" style="stop-color:#06b6d4"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Briefcase -->
  <g transform="translate(400, 240)" fill="none" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="-90" y="-20" width="180" height="120" rx="10"/>
    <path d="M-50 -20 L-50 -55 Q-50 -70 -35 -70 L35 -70 Q50 -70 50 -55 L50 -20"/>
    <line x1="-90" y1="30" x2="90" y2="30"/>
  </g>
  <!-- Checkmark -->
  <g fill="none" stroke="white" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M320 280 L350 310 L400 260"/>
  </g>
  <!-- Arrow up -->
  <g fill="none" stroke="white" stroke-width="4" stroke-linecap="round" opacity="0.4">
    <line x1="520" y1="360" x2="520" y2="180"/>
    <path d="M505 200 L520 170 L535 200"/>
  </g>
  <text x="400" y="490" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="34" fill="white" font-weight="bold" letter-spacing="1">SMART JOB APPLIER</text>
  <text x="400" y="525" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="16" fill="white" opacity="0.6" letter-spacing="3">AUTOMATED CAREER TOOL</text>
</svg>